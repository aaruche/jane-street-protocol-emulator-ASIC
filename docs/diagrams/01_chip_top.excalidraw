      "updated": 1,
      "link": null,
      "locked": false,
      "text": "one clock domain: clk \u2192 all flops",
      "originalText": "one clock domain: clk \u2192 all flops",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "a-066",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "note-068",
      "type": "rectangle",
      "x": 40,
      "y": 730,
      "width": 1300,
      "height": 150,
      "angle": 0,
      "strokeColor": "#868e96",
