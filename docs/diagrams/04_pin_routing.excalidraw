    {
      "id": "t-052",
      "type": "text",
      "x": 50,
      "y": 678,
      "width": 878.08,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1148091554,
      "version": 1,
      "versionNonce": 1391565286,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Reset: PINDIRS = 0, OD_MASK = 0 \u2192 uio_oe = 0 (every pin is an input).\nOpen-drain pin: write 0 \u2192 drive low; write 1 \u2192 release to the external pull-up. It never drives 1.\nIN0\u2013IN4 (ui_in[7:3]) use the same 2-FF sync; OUT0\u2013OUT4 (uo_out[7:3]) are always driven.",
      "originalText": "Reset: PINDIRS = 0, OD_MASK = 0 \u2192 uio_oe = 0 (every pin is an input).\nOpen-drain pin: write 0 \u2192 drive low; write 1 \u2192 release to the external pull-up. It never drives 1.\nIN0\u2013IN4 (ui_in[7:3]) use the same 2-FF sync; OUT0\u2013OUT4 (uo_out[7:3]) are always driven.",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "note_a-051",
      "autoResize": true,
      "lineHeight": 1.25
    },
