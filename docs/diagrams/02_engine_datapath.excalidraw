    {
      "id": "t-074",
      "type": "text",
      "x": 1340,
      "y": 648,
      "width": 439.04,
      "height": 120.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
